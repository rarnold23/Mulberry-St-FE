{
  "version": 2,
  "name": "mulberry-street-radio",
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/mulberrystradio",
      "dest": "/index.html"
    },
    {
      "src": "/mulberrystradio/(.*)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
